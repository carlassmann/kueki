{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kueki",
  "keep_vars": true,
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  // Production answers on kueki.app only; a workers.dev twin would be a second indexable origin.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    {
      "name": "REGISTRATION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
  "env": {
    // The end-to-end suite runs against this Worker, so it must never touch production storage:
    // a separate script name gives ROOMS its own Durable Object namespace and its own rate limiter.
    "preview": {
      "name": "kueki-preview",
      // Cloudflare generates no preview URLs for a Worker with a Durable Object, so each pull
      // request gets its own Worker script (kueki-pr-<number>) rather than a preview of this one.
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
      },
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
      "ratelimits": [
        {
          "name": "REGISTRATION_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
  },
}
